{
  "name": "mdasifhossainadim/wp-plugin-starter",
  "description": "WP Plugin Starter is a modern, extensible WordPress plugin boilerplate. It provides a robust foundation for building advanced plugins, featuring modular architecture, dependency injection, REST API integration, and best practices for WordPress and WooCommerce development. Ideal for both single-site and multi-vendor marketplace enhancements.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "Md. Asif Hossain Nadim",
      "email": "devianadim@gmail.com",
      "homepage": "https://profiles.wordpress.org/devianadim9/"
    }
  ],
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "php": ">=7.4",
    "ext-json": "*"
  },
  "require-dev": {
    "coenjacobs/mozart": "^0.7.1",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^9.5",
    "squizlabs/php_codesniffer": "^3.7",
    "szepeviktor/phpstan-wordpress": "^2.0",
    "woocommerce/woocommerce-sniffs": "^1.0",
    "wp-coding-standards/wpcs": "^3.1",
    "yoast/phpunit-polyfills": "^4.0"
  },
  "autoload": {
    "psr-4": {
      "WPPluginStarter\\": "includes/",
      "WPPluginStarter\\Dependencies\\": "dependencies/"
    },
    "files": [
      "includes/functions.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "WPPluginStarter\\Tests\\": "tests/php/src/"
    }
  },
  "scripts": {
    "post-install-cmd": [
      "[ $COMPOSER_DEV_MODE -eq 0 ] || \"vendor/bin/mozart\" compose",
      "composer dump-autoload"
    ],
    "post-update-cmd": [
      "[ $COMPOSER_DEV_MODE -eq 0 ] || \"vendor/bin/mozart\" compose",
      "composer dump-autoload"
    ],
    "phpcs": "phpcs --standard=phpcs.xml",
    "phpcbf": "phpcbf --standard=phpcs.xml",
    "phpstan": "phpstan analyse",
    "test": "phpunit",
    "test:coverage": "phpunit --coverage-html=coverage",
    "format": "@phpcbf",
    "lint": "@phpcs",
    "analyse": "@phpstan"
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "platform": {
      "php": "7.4"
    },
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "extra": {
    "mozart": {
      "dep_namespace": "WPPluginStarter\\Dependencies\\",
      "dep_directory": "/dependencies/",
      "classmap_directory": "/dependencies/classes/",
      "classmap_prefix": "WPPluginStarter",
      "packages": [
        "league/container",
        "psr/container"
      ],
      "excluded_packages": [],
      "override_autoload": {},
      "delete_vendor_directories": true
    }
  }
}
